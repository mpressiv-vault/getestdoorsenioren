---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
{items.length > 0 && (
  <section class="faq" aria-labelledby="faq-title">
    <h2 id="faq-title">Veelgestelde vragen</h2>
    {items.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </section>
)}
