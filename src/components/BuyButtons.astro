---
import { koopLinks, euro } from '../lib';
interface Props { product: any; compact?: boolean; max?: number; prijs?: boolean }
const { product, compact = false, max, prijs = true } = Astro.props;
const alle = koopLinks(product);
const links = max ? alle.slice(0, max) : alle;
const overig = max ? alle.slice(max) : [];
---
{alle.length > 0 && (
  <div class:list={['buy', { compact }]}>
    {links.map((l) => (
      <a class="btn-buy" href={l.url} rel="sponsored nofollow noopener" target="_blank" aria-label={`Bekijk bij ${l.label}${l.prijs != null ? ', ' + euro(l.prijs) : ''} (opent een andere website)`}>
        <span>Bekijk bij {l.label}{prijs && l.prijs != null && <span class="buy-p">{euro(l.prijs)}</span>}</span><span aria-hidden="true">→</span>
      </a>
    ))}
    {overig.length > 0 && (
      <p class="buy-more">Ook bij {overig.map((l, i) => (
        <><a href={l.url} rel="sponsored nofollow noopener" target="_blank">{l.label}{l.prijs != null && ` (${euro(l.prijs)})`}</a>{i < overig.length - 2 ? ', ' : i === overig.length - 2 ? ' en ' : ''}</>
      ))}</p>
    )}
    {!compact && <span class="ext-hint">Opent de website van de winkel.</span>}
    {!compact && product.prijs?.datum && <p class="price-note">Prijs gecontroleerd op {product.prijs.datum}. Prijzen kunnen veranderen.</p>}
  </div>
)}
