---
// Eén compacte regel boven de inhoud: hoe deze pagina tot stand kwam.
interface Props { papier?: boolean }
const { papier = true } = Astro.props;
---
{papier && (
  <aside class="pagenote" aria-label="Over deze pagina">
    <ul>
      <li><strong>Vergeleken op papier.</strong> Nog niet door ons testpanel getest.</li>
      <li><a href="/zo-vergelijken-wij/">Zo vergelijken wij</a></li>
    </ul>
  </aside>
)}
