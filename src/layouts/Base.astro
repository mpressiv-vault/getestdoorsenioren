---
import Head from '../components/Head.astro';
import site from '../data/site.json';
import '@fontsource/atkinson-hyperlegible-next/400.css';
import '@fontsource/atkinson-hyperlegible-next/700.css';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
interface Props { title: string; description: string; jsonld?: object[]; noindex?: boolean; type?: string }
const props = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="nl">
  <head><Head {...props} /></head>
  <body>
    <a class="skip" href="#inhoud">Direct naar de inhoud</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href="/" aria-label="Getest door senioren, naar de homepage">
          <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="var(--accent)"/><path d="M12 20.5l5.5 5.5L28.5 14" fill="none" stroke="#fff" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Getest door senioren</span>
        </a>
        <nav class="main-nav" aria-label="Hoofdmenu">
          <ul>{site.nav.map((n) => <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>)}</ul>
        </nav>
      </div>
    </header>
    <main id="inhoud"><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p class="footer-brand">Getest door senioren</p>
          <p>Onafhankelijke vergelijkingen van producten voor senioren, geschreven voor senioren en hun familie. Een uitgave van {site.publisher}.</p>
        </div>
        <div>
          <p class="footer-h">Vergelijkingen</p>
          <ul><li><a href="/seniorentelefoons/">Seniorentelefoons</a></li></ul>
        </div>
        <div>
          <p class="footer-h">Over deze site</p>
          <ul>
            <li><a href="/zo-vergelijken-wij/">Zo vergelijken wij</a></li>
            <li><a href="/over-ons/">Over ons en hoe wij verdienen</a></li>
            <li><a href="/privacy/">Privacy en cookies</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap footer-small"><p>Deze site gebruikt geen trackingcookies.</p></div>
    </footer>
  </body>
</html>
