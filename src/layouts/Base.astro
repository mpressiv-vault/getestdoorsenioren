---
import Head from '../components/Head.astro';
import site from '../data/site.json';
import '@fontsource/atkinson-hyperlegible-next/400.css';
import '@fontsource/atkinson-hyperlegible-next/700.css';
import '../styles/global.css';
interface Props { title: string; description: string; jsonld?: object[]; noindex?: boolean; type?: string }
const props = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="nl">
  <head><Head {...props} /></head>
  <body>
    <a class="skip" href="#inhoud">Direct naar de inhoud</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href="/" aria-label="Getest door senioren, naar de homepage">
          <svg class="logo-mark" width="44" height="44" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="31" fill="#0C2643"/><circle cx="32" cy="32" r="25" fill="none" stroke="#F2A900" stroke-width="3"/><circle cx="32" cy="32" r="19.5" fill="#F2A900"/><path d="M23.5 32.5l6 6 11-12.5" fill="none" stroke="#12355B" stroke-width="4.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="logo-text"><span class="logo-t">Getest door</span><span class="logo-s">senioren</span></span>
        </a>
        <span class="header-tag">Onafhankelijk vergeleken</span>
        <nav class="main-nav" aria-label="Hoofdmenu">
          <ul>{site.nav.map((n) => <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>)}</ul>
        </nav>
        <details class="menu-m">
          <summary><span class="menu-ico" aria-hidden="true"></span>Menu</summary>
          <nav aria-label="Menu">
            <ul>{site.nav.map((n) => <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>)}</ul>
          </nav>
        </details>
      </div>
    </header>
    <main id="inhoud"><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p class="footer-brand"><svg width="36" height="36" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="31" fill="#12355B"/><circle cx="32" cy="32" r="25" fill="none" stroke="#F2A900" stroke-width="3"/><circle cx="32" cy="32" r="19.5" fill="#F2A900"/><path d="M23.5 32.5l6 6 11-12.5" fill="none" stroke="#12355B" stroke-width="4.6" stroke-linecap="round" stroke-linejoin="round"/></svg> Getest door senioren</p>
          <p>Onafhankelijke vergelijkingen van producten voor senioren, geschreven voor senioren en hun familie.</p>
        </div>
        <div>
          <p class="footer-h">Vergelijkingen</p>
          <ul><li><a href="/seniorentelefoons/">Seniorentelefoons</a></li></ul>
        </div>
        <div>
          <p class="footer-h">Over deze site</p>
          <ul>
            <li><a href="/zo-vergelijken-wij/">Zo vergelijken wij</a></li>
            <li><a href="/over-ons/">Over ons</a></li>
            <li><a href="/privacy/">Privacy en cookies</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap footer-small"><p>Deze site gebruikt geen trackingcookies.</p></div>
    </footer>
  </body>
</html>
